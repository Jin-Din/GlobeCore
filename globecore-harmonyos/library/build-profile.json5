{
  "apiType": "stageMode",
  "buildOption": {
    // native 构建：与 Android 侧 globecore 同构的 CMake 工程（引擎源码经 GLOBECORE_ENGINE_ROOT
    // 直接引用 ../globecore/src/main/cpp，单一源树两端共享）。
    // 第三方 .a 由 `build-scripts/build-all.sh --target ohos` 产出到 build-scripts/out/ohos/<abi>/。
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      // 本工程经 junction 引入 demo，CMakeLists 默认的「向上 5 级派生」基准会漂移到不存在的路径，
      // 故在此显式传绝对路径覆盖（CMake 接受正斜杠）。第三方 .a 目录同理指向本地构建产物。
      // GLOBECORE_LITE=ON：裁掉 GDAL/PROJ/KML 依赖链（详见 CMakeLists 顶部注释），
      // 在线瓦片 + 三维地形不受影响，可省下 GDAL/PROJ 的长时间交叉编译。
      "arguments": "-DGLOBECORE_LITE=ON -DGLOBECORE_ENGINE_ROOT=E:/WorkBuddy/qt_ohos_map_sdk/vendor/GlobeCore/globecore/src/main/cpp -DGLOBECORE_THIRD_PARTY_DIR=E:/WorkBuddy/qt_ohos_map_sdk/build/ohos-deps/export",
      "cppFlags": "",
      // feature/terrain-pre：本地验证阶段只编 arm64-v8a（真机 5KLBB25911200313）。
      // 第三方 .a 需按 ABI 各编一套（每套 GDAL+PROJ 约 40 分钟），先保真机闭环；
      // 待 arm64 跑通后再补 x86_64（模拟器）并恢复双 ABI。
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          },
          "consumerFiles": [
            "./consumer-rules.txt"
          ]
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    }
  ]
}
